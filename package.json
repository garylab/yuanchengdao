{
  "name": "yuancheng.co",
  "version": "1.0.0",
  "description": "远程OK - Remote jobs for Chinese professionals",
  "private": true,
  "type": "module",
  "scripts": {
    "build:assets": "tsx scripts/build-assets.ts",
    "dev": "npm run build:assets && wrangler dev",
    "deploy": "npm run build:assets && wrangler deploy",
    "db:create": "wrangler d1 create yuanchengdao",
    "db:migrate": "wrangler d1 execute yuanchengdao --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute yuanchengdao --local --file=./schema.sql",
    "db:migrate:auth": "wrangler d1 execute yuanchengdao --remote --file=./migrations/0003_users_auth.sql",
    "db:migrate:auth:local": "wrangler d1 execute yuanchengdao --local --file=./migrations/0003_users_auth.sql",
    "db:migrate:blocked": "wrangler d1 execute yuanchengdao --remote --file=./migrations/0011_blocked_sources.sql",
    "db:migrate:blocked:local": "wrangler d1 execute yuanchengdao --local --file=./migrations/0011_blocked_sources.sql",
    "vectorize:create": "wrangler vectorize create jobs-search --dimensions=1024 --metric=cosine",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "better-sqlite3": "^11.0.0",
    "tailwindcss": "^3.4.19",
    "terser": "^5.46.1",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.73.0"
  },
  "dependencies": {
    "hono": "^4.12.7",
    "openai": "^6.29.0"
  }
}
